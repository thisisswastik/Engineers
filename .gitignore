# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables — never commit real secrets
.env

# Runtime logs and database checkpoints (but track the directory via .gitkeep)
logs/*
!logs/.gitkeep
*.sqlite
*.log

# Generated application code from Coder agent (but track directory via .gitkeep)
test_project/*
!test_project/.gitkeep
