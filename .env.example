# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ==============================================================================
# REQUIRED — Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# MCP Server Configuration
# These are auto-resolved at runtime. Only override if you have a custom setup.
# ==============================================================================

# Root directory where the Coder agent writes generated application files.
# Default (local dev):  <repo_root>/test_project
# Default (Docker):     /app/test_project  (set automatically in docker-compose)
# MCP_WORKSPACE_ROOT=/app/test_project

# Path to the mcp-server-sqlite binary.
# Default (local dev):  auto-detected via shutil.which() or .venv/Scripts/
# Default (Docker):     /usr/local/bin/mcp-server-sqlite  (set automatically)
# MCP_SQLITE_BIN=/usr/local/bin/mcp-server-sqlite

# Path to the SQLite database used by the Coder agent.
# Default: <MCP_WORKSPACE_ROOT>/database.sqlite
# MCP_DB_PATH=/app/test_project/database.sqlite

# ==============================================================================
# Optional — API Server Settings
# ==============================================================================
# API_HOST=0.0.0.0
# API_PORT=8000

# ==============================================================================
# Optional — Observability / Telemetry
# ==============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
